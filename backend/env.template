# OpenAI Configuration (required if using OpenAI agent)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Agent Configuration
# Set to "openai" to use OpenAI models, "ollama" (or any other value) to use Ollama
AGENT_TYPE=ollama

# Ollama Configuration (required if using Ollama agent)
# Make sure Ollama is running locally on http://localhost:11434
# Install Ollama from: https://ollama.ai/
# Run: ollama pull qwen:latest (or your preferred model)
